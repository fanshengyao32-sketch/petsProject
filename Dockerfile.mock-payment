FROM golang:1.27-alpine AS build
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w" -o /out/mock-payment ./cmd/mock-payment

FROM alpine:3.22
RUN apk add --no-cache wget && addgroup -S app && adduser -S -G app app
USER app
COPY --from=build /out/mock-payment /mock-payment
EXPOSE 8081
ENTRYPOINT ["/mock-payment"]

